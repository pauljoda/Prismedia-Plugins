{
  "manifestVersion": 2,
  "apiTags": [
    "prismedia"
  ],
  "id": "openlibrary",
  "name": "Open Library",
  "version": "0.3.2",
  "date": "2026-07-09",
  "runtime": "dotnet-process",
  "entry": "dist/Prismedia.Plugin.OpenLibrary.dll",
  "compat": {
    "pluginApiMin": "2.0.0",
    "pluginApiMax": null,
    "prismediaMin": "2.0.1",
    "prismediaMax": null
  },
  "auth": [],
  "isNsfw": false,
  "description": "Book, book-series, edition, and author metadata from Open Library",
  "author": "Prismedia Community",
  "supports": [
    {
      "entityKind": "book",
      "actions": [
        "lookup-id",
        "lookup-url",
        "search"
      ],
      "identityNamespaces": ["openlibrary", "openlibrarywork", "openlibraryedition", "isbn", "isbn10", "isbn13"],
      "search": {
        "fields": [
          { "key": "title", "label": "Title", "type": "text", "required": true, "placeholder": "Book or series title" },
          { "key": "author", "label": "Author", "type": "text", "required": false, "placeholder": "Author name" },
          { "key": "year", "label": "First published", "type": "year", "required": false, "placeholder": "1996" },
          { "key": "seriesTitle", "label": "Series", "type": "text", "required": false, "placeholder": "Series title" }
        ]
      }
    },
    {
      "entityKind": "book-volume",
      "actions": [
        "lookup-id",
        "lookup-url",
        "search"
      ],
      "identityNamespaces": ["openlibrary", "openlibrarywork", "openlibraryedition", "isbn", "isbn10", "isbn13"],
      "search": {
        "fields": [
          { "key": "title", "label": "Volume title", "type": "text", "required": true, "placeholder": "Volume title" },
          { "key": "author", "label": "Author", "type": "text", "required": false, "placeholder": "Author name" },
          { "key": "year", "label": "First published", "type": "year", "required": false, "placeholder": "1996" },
          { "key": "seriesTitle", "label": "Series", "type": "text", "required": false, "placeholder": "Series title" }
        ]
      }
    },
    {
      "entityKind": "person",
      "actions": [
        "lookup-id",
        "lookup-url",
        "search"
      ],
      "identityNamespaces": ["openlibrary", "openlibraryauthor"],
      "search": {
        "fields": [
          { "key": "title", "label": "Author", "type": "text", "required": true, "placeholder": "Author name" },
          { "key": "birthYear", "label": "Birth year", "type": "year", "required": false, "placeholder": "1948" }
        ]
      }
    }
  ]
}
