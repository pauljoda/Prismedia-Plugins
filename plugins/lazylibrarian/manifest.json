{
  "manifestVersion": 2,
  "apiTags": ["prismedia"],
  "id": "lazylibrarian",
  "name": "LazyLibrarian",
  "version": "1.3.0",
  "date": "2026-09-24",
  "icon": "assets/icon.svg",
  "runtime": "dotnet-process",
  "entry": "dist/Prismedia.Plugin.LazyLibrarian.dll",
  "compat": {
    "pluginApiMin": "2.0.0",
    "pluginApiMax": null,
    "prismediaMin": "3.8.0",
    "prismediaMax": null
  },
  "auth": [
    { "key": "apiKey", "label": "API key", "required": true, "url": null }
  ],
  "isNsfw": false,
  "supports": [],
  "integration": {
    "protocolVersion": 1,
    "capabilities": [
      {
        "kind": "connected-library",
        "operations": ["search-library", "get-library-item", "list-libraries"],
        "entityKinds": ["book"]
      },
      {
        "kind": "external-manager",
        "operations": ["manager-options", "lookup-managed", "reconcile-managed", "configure-managed", "request-managed"],
        "entityKinds": ["book"]
      }
    ],
    "settings": [
      { "key": "ebookRoot", "label": "LazyLibrarian ebook root", "type": "text", "required": true,
        "placeholder": "/books", "help": "Absolute path as reported by LazyLibrarian. Map it to a Prismedia library folder." },
      { "key": "audiobookRoot", "label": "LazyLibrarian audiobook root", "type": "text", "required": true,
        "placeholder": "/audiobooks", "help": "Absolute path as reported by LazyLibrarian. Map it to a Prismedia library folder." }
    ]
  }
}
